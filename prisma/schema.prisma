generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  ESTOQUE
  COZINHA
  CONFERENTE
}

model User {
  id          String   @id @default(cuid())
  name        String
  login       String   @unique
  password    String
  role        UserRole
  /// Mapa opcional de permissões por módulo; null usa apenas o padrão do papel.
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
