generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  ESTOQUE
  COZINHA
  CONFERENTE
}

model User {
  id          String   @id @default(cuid())
  name        String
  login       String   @unique
  password    String
  role        UserRole
  /// Mapa opcional de permissões por módulo; null usa apenas o padrão do papel.
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cashRegistersOpened CashRegister[] @relation("CashOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashClosedBy")
}

model CashRegister {
  id             String    @id @default(cuid())
  openedById     String
  openedBy       User      @relation("CashOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime @default(now())
  initialValue   Float
  closedAt       DateTime?
  closedById     String?
  closedBy       User?    @relation("CashClosedBy", fields: [closedById], references: [id])
  /// Valor contado ao fechar (opcional).
  closingBalance Float?
}
