generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  ESTOQUE
  COZINHA
  CONFERENTE
}

model User {
  id          String   @id @default(cuid())
  name        String
  login       String   @unique
  password    String
  role        UserRole
  /// Mapa opcional de permissões por módulo; null usa apenas o padrão do papel.
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cashRegistersOpened CashRegister[] @relation("CashOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashClosedBy")
  ordersCreated       Order[]         @relation("OrderCreatedBy")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  document  String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum ProductType {
  GELADO
  QUENTE
}

model Product {
  id            String      @id @default(cuid())
  name          String
  price         Float
  stock         Float       @default(0)
  productType   ProductType @default(GELADO)
  isKitchenItem Boolean     @default(false)
  controlsStock Boolean     @default(true)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

enum OrderKind {
  DIRECT
  COMANDA
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum KitchenItemStatus {
  PENDING
  QUEUE
  PREPARING
  READY
}

model Order {
  id          String      @id @default(cuid())
  kind        OrderKind
  /// Cliente cadastrado (faturamento / relatórios). Opcional.
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  /// Rótulo rápido (ex.: mesa) quando não há cliente ou como complemento.
  clientName  String?
  status      OrderStatus @default(OPEN)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  createdById String
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  quantity      Float
  unitPrice     Float
  kitchenStatus KitchenItemStatus?
}

model CashRegister {
  id             String    @id @default(cuid())
  openedById     String
  openedBy       User      @relation("CashOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime @default(now())
  initialValue   Float
  closedAt       DateTime?
  closedById     String?
  closedBy       User?    @relation("CashClosedBy", fields: [closedById], references: [id])
  /// Valor contado ao fechar (opcional).
  closingBalance Float?
}
