generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  ESTOQUE
  COZINHA
  CONFERENTE
}

model User {
  id          String   @id @default(cuid())
  name        String
  login       String   @unique
  password    String
  role        UserRole
  /// Mapa opcional de permissões por módulo; null usa apenas o padrão do papel.
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cashRegistersOpened CashRegister[] @relation("CashOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashClosedBy")
  cashMovements       CashMovement[] @relation("CashMovementCreatedBy")
  ordersCreated       Order[]         @relation("OrderCreatedBy")
  ordersClosed        Order[]         @relation("OrderClosedBy")
  stockMovements      StockMovement[] @relation("StockMovementCreatedBy")
}

/// Configuração global (uma linha id = default): padrões para novos pedidos.
model CommercialSettings {
  id     String @id @default("default")
  couvertEnabled Boolean @default(false)
  couvertMode    CommercialChargeMode @default(PERCENT)
  /// % (ex.: 10) ou valor fixo em R$, conforme couvertMode.
  couvertValue   Float @default(0)
  serviceFeeEnabled Boolean @default(false)
  serviceFeeMode    CommercialChargeMode @default(PERCENT)
  serviceFeeValue   Float @default(0)
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  document  String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum StockMovementKind {
  ENTRADA
  SAIDA
  AJUSTE
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  price         Float
  stock         Float       @default(0)
  /// Alerta no ERP / PDV quando saldo ≤ este valor.
  minStock      Float       @default(0)
  /// Custo médio ponderado (atualizado em entradas com preço de custo).
  averageCost   Float?
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isKitchenItem Boolean     @default(false)
  controlsStock Boolean     @default(true)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  stockMovements StockMovement[]
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind          StockMovementKind
  balanceBefore Float
  balanceAfter  Float
  /// Preço unitário de custo nesta entrada (opcional).
  unitCost      Float?
  note          String?
  createdById   String
  createdBy     User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
}

enum OrderKind {
  DIRECT
  COMANDA
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CommercialChargeMode {
  PERCENT
  FIXED
}

enum KitchenItemStatus {
  PENDING
  QUEUE
  PREPARING
  READY
}

model Order {
  id          String      @id @default(cuid())
  kind        OrderKind
  /// Cliente cadastrado (faturamento / relatórios). Opcional.
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  /// Rótulo rápido (ex.: mesa) quando não há cliente ou como complemento.
  clientName  String?
  status      OrderStatus @default(OPEN)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  /// Última interação no pedido (itens) — usado para ordenar comandas “paradas”.
  lastActivityAt DateTime @default(now())
  cancelledAt DateTime?
  /// Turno de caixa em que o pedido foi fechado (reabrir só se o mesmo caixa ainda estiver aberto).
  closedCashRegisterId String?
  closedCashRegister   CashRegister? @relation("OrderClosedInCash", fields: [closedCashRegisterId], references: [id], onDelete: SetNull)
  /// Operador que registrou o fechamento da venda (pagamento).
  closedById  String?
  closedBy    User?       @relation("OrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  couvertEnabled Boolean @default(false)
  couvertMode    CommercialChargeMode @default(PERCENT)
  couvertValue   Float @default(0)
  serviceFeeEnabled Boolean @default(false)
  serviceFeeMode    CommercialChargeMode @default(PERCENT)
  serviceFeeValue   Float @default(0)
  items       OrderItem[]
  payments    OrderPayment[]
}

enum PaymentMethodKind {
  DINHEIRO
  DEBITO
  CREDITO
  VALE
}

model PaymentMethod {
  id         String            @id @default(cuid())
  name       String
  kind       PaymentMethodKind
  /// Taxa percentual opcional (ex.: 3 = 3%). Aplicada sobre o valor bruto no fechamento.
  feePercent Float?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  payments   OrderPayment[]
}

model OrderPayment {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  /// Valor bruto pago nesta parcela (o que entra na soma do pedido).
  amountPaid      Float
  feeAmount       Float
  /// Valor líquido após taxa da maquininha (fim de mês).
  netAmount       Float
  /// Só para DINHEIRO: valor que o cliente entregou (para cálculo de troco).
  cashReceived    Float?
  createdAt       DateTime       @default(now())
}

model OrderItem {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  quantity      Float
  unitPrice     Float
  kitchenStatus KitchenItemStatus?
}

enum CashShift {
  MANHA
  TARDE
  NOITE
  CUSTOM
}

enum CashMovementType {
  SANGRIA
  SUPRIMENTO
}

model CashRegister {
  id               String    @id @default(cuid())
  openedById       String
  openedBy         User      @relation("CashOpenedBy", fields: [openedById], references: [id])
  openedAt         DateTime  @default(now())
  initialValue     Float
  /// Turno declarado na abertura (relatórios).
  shift            CashShift @default(MANHA)
  /// Rótulo quando shift = CUSTOM.
  shiftCustomLabel String?
  /// Observações do operador na abertura.
  openingNotes     String?
  /// Conferência opcional: mapa valor da cédula/moeda (string) → quantidade.
  denominationsJson Json?
  closedAt         DateTime?
  closedById       String?
  closedBy         User?     @relation("CashClosedBy", fields: [closedById], references: [id])
  /// Valor contado ao fechar (opcional).
  closingBalance   Float?
  movements        CashMovement[]
  ordersClosed     Order[]       @relation("OrderClosedInCash")
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           CashMovementType
  amount         Float
  note           String?
  createdById    String
  createdBy      User             @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
}
