{
  "name": "gato-negro-pdv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDV Desktop — Electron + Node + SQLite",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 tcp:3001 && cross-env ELECTRON_DISABLE_SANDBOX=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "prisma generate && vite build",
    "start:prod": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "preview": "concurrently -k \"npm run start:prod\" \"wait-on tcp:3001 && cross-env NODE_ENV=production ELECTRON_DISABLE_SANDBOX=1 electron .\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.1"
  }
}
