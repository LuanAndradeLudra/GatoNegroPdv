{
  "name": "gato-negro-pdv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDV Desktop — Electron + Node + SQLite",
  "author": "LUDRA",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 tcp:3001 && cross-env ELECTRON_DISABLE_SANDBOX=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "prisma generate && vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist-server/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "build:db-template": "node scripts/build-db-template.mjs",
    "pack:prepare": "prisma generate && vite build && npm run build:server && npm run build:db-template",
    "dist:win": "npm run pack:prepare && electron-builder --win --publish never",
    "start:prod": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "preview": "concurrently -k \"npm run start:prod\" \"wait-on tcp:3001 && cross-env NODE_ENV=production ELECTRON_DISABLE_SANDBOX=1 electron .\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.7.0"
  },
  "build": {
    "appId": "com.ludra.gatonegro.pdv",
    "productName": "Gato Negro PDV",
    "copyright": "Copyright © ${author}",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*",
      {
        "from": "dist",
        "to": "dist",
        "filter": ["**/*"]
      },
      {
        "from": "dist-server",
        "to": "dist-server",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "asarUnpack": ["node_modules/.prisma/**", "node_modules/@prisma/**"],
    "extraResources": [
      {
        "from": "build/db-template.sqlite",
        "to": "db-template.sqlite"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.8",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.1"
  }
}
