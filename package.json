{
  "name": "gato-negro-pdv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDV — Node + PostgreSQL + Vite",
  "author": "LUDRA",
  "scripts": {
    "dev": "docker compose up -d db && wait-on -t 120000 tcp:127.0.0.1:5433 && concurrently -k \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:app": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:vite": "vite",
    "build": "prisma generate && vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist-server/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "pack:prepare": "prisma generate && vite build && npm run build:server",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "start:prod": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "preview": "concurrently -k \"npm run start:prod\" \"wait-on tcp:3001 && vite preview --host 127.0.0.1 --port 5173\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/client": "^6.5.0",
    "prisma": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.7.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.1"
  }
}
